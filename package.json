{
  "name": "signature-app",
  "version": "1.0.0",
  "description": "Signature application with canvas functionality",
  "main": "index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:watch": "react-scripts test --watchAll",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:ci": "react-scripts test --coverage --watchAll=false --ci",
    "test:go": "cd submitImage && go test ./... -v",
    "test:go-coverage": "cd submitImage && go test ./... -v -coverprofile=coverage.out && go tool cover -html=coverage.out -o coverage.html",
    "test:all": "npm run test:ci && npm run test:go",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "react": "16.0.1",
    "react-dom": "16.0.1",
    "signature_pad": "^4.0.0",
    "node-forge": "0.10.0",
    "axios": "0.19.2",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/node": "^16.0.0"
  },
  "devDependencies": {
    "typescript": "^4.5.0",
    "@testing-library/react": "^12.0.0",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/user-event": "^13.0.0",
    "@types/jest": "^27.0.0",
    "react-scripts": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^2.5.0"
  }
}